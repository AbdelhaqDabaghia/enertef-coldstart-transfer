# =============================================================================
# kpi_reporting.patch -- one KPI row, one meaning.
#
# REBASED 2026-09-16 onto svc1-runner f113630.
#
# The original version of this patch had two hunks. The second one -- writing
# planning.mpc_setpoints per charger instead of labelling the combined u1+u2
# as EMOB1 -- has been superseded by:
#
#   f113630  Persist mpc_setpoints per charger (u1->EMOB1, u2->EMOB2)
#
# which makes the identical change with a better commit message. DO NOT
# re-apply it; that hunk is deleted below rather than left commented out, so
# there is nothing to double-apply by accident.
#
# Worth recording how that defect grew. I originally reported it as a
# "labelling bug": the DB said EMOB1 while holding the site total. It was
# worse. The actuation path had the same flaw, and EMOB2 was never commanded at
# all -- half the site's flexibility did not exist. Fixed in 3028175.
#
# STATUS OF THE REMAINING HUNK: not applied. It targets svc1-runner, whose
# working tree is now clean and whose owner is another session. Coordinate
# before applying.
# =============================================================================


# -----------------------------------------------------------------------------
# THE DEFECT
#
# In the deployed runner (svc1-runner, 22 Jul onwards):
#
#     MIN_SAVINGS_EUR_FOR_PASS = 5.0
#     main_verdict = 'PASS' if savings_eur >= MIN_SAVINGS_EUR_FOR_PASS else 'FAIL'
#     kpi_rows.append((1, 'realtime', now, 'cost_reduction_pct',
#                      cost_reduction_value, 5.0, main_verdict, notes_main))
#
# One row carrying three different quantities that all read as "5.0":
#   * measured_value is a PERCENTAGE
#   * threshold says 5.0, which a reader will take as 5 %
#   * verdict was decided on 5.0 EUR
#
# A dashboard rendering value / threshold / verdict generically produces a row
# that looks internally consistent and is not. And
# contextual.services.pass_threshold for service-1 says 20, which nothing reads.
#
# The absolute-EUR rule is KEPT. Its stated motivation is sound -- a ratio is
# unstable when the baseline cost is near zero, which is exactly the regime this
# site sits in. It simply belongs in its own row, with its own units.
#
# Two earlier copies of realtime_runner (2 Jul, enertef-svc1-clean and
# enertef-svc1-source/task, byte-identical) carry a worse variant where the
# verdict came from export_reduction_pct -- a different metric entirely. Those
# are stale; the deployed lineage is svc1-runner. Do not patch them.
# -----------------------------------------------------------------------------
--- a/realtime_runner.py
+++ b/realtime_runner.py
@@ -664,12 +664,26 @@
     MIN_SAVINGS_EUR_FOR_PASS = 5.0
-    main_verdict = 'PASS' if result.get('savings_eur', 0) >= MIN_SAVINGS_EUR_FOR_PASS else 'FAIL'
+    # Single source of truth: contextual.services.pass_threshold for service-1.
+    COST_REDUCTION_THRESHOLD_PCT = 20.0
+    savings_eur = float(result.get('savings_eur', 0) or 0.0)
     notes_main = (
         f"NTUA-fidele: cost {result['cost_optimised']:.2f}E vs baseline {result['cost_baseline']:.2f}E, "
-        f"savings {result.get('savings_eur', 0):.2f}E"
+        f"savings {savings_eur:.2f}E. PLANNED: both cost figures derive from the "
+        f"forecast, not from measurement. See cost_reduction_pct_realised."
     )
     cost_reduction_value = float(result['reduction_pct']) if result['reduction_pct'] is not None else 0.0
-    kpi_rows.append((1, 'realtime', now, 'cost_reduction_pct',
-                     cost_reduction_value, 5.0, main_verdict, notes_main))
+    # The percentage KPI, judged against the percentage threshold.
+    kpi_rows.append((1, 'realtime', now, 'cost_reduction_pct_planned',
+                     cost_reduction_value, COST_REDUCTION_THRESHOLD_PCT,
+                     'PASS' if cost_reduction_value >= COST_REDUCTION_THRESHOLD_PCT
+                     else 'FAIL', notes_main))
+    # The absolute-savings rule, in its own units. Kept because a ratio is
+    # meaningless when the baseline cost is near zero, but it is a different
+    # statement and belongs in a different row.
+    kpi_rows.append((1, 'realtime', now, 'savings_eur_planned',
+                     savings_eur, MIN_SAVINGS_EUR_FOR_PASS,
+                     'PASS' if savings_eur >= MIN_SAVINGS_EUR_FOR_PASS else 'FAIL',
+                     notes_main))
+    main_verdict = ('PASS' if savings_eur >= MIN_SAVINGS_EUR_FOR_PASS else 'FAIL')


# =============================================================================
# NOT PATCHED HERE: the planned/realised gap.
#
# cost_base comes from the forecast baseline and cost_opt from the planned
# profile, so the reported reduction never meets measurement. That cannot be
# fixed inside realtime_runner, because at plan time the realised series does
# not exist. It is fixed by scripts/settle_kpis.py at J+1, which re-applies the
# issued setpoints to the demand and generation that arrived and writes
# cost_reduction_pct_realised alongside. The renaming above exists so the two
# rows read as a pair.
#
# A DATE THAT MATTERS FOR SETTLEMENT. Until 2026-09-16 06:19 UTC the MQTT
# publish to the chargers failed on every cycle -- 400 consecutive failures
# over the preceding fortnight, zero successes. The controller computed plans
# and reported savings that were never dispatched. Settling any period before
# that timestamp would produce a COUNTERFACTUAL labelled as realised: what the
# site would have saved had the plan been applied. It was not. Settlement is
# only meaningful from 2026-09-16 06:19 UTC onwards, when both chargers began
# actuating.
#
# DEPLOYMENT ORDER
#   1. deploy/validation_v2.py first -- the absolute persistence floor, before
#      any change that alters what gets promoted.
#   2. this patch, so the planned row is named _planned.
#   3. schedule settle_kpis.py daily in the VPC, after the J-1 ingest.
#   4. point /kpi-summary at _realised for the headline, keeping _planned
#      visible -- the gap between them is information, not noise.
# =============================================================================
